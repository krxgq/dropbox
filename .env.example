NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
# Local development only. Replace with: openssl rand -hex 32
SESSION_SECRET=local-development-only-change-this-secret-32chars
DATABASE_URL=postgresql://dropbox:local-training-only@localhost:5432/dropbox
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.data/files
# Azure uses these instead of DATABASE_URL; no database password or storage keys.
# PGHOST=your-server.postgres.database.azure.com
# PGDATABASE=dropbox
# PGUSER=dropbox-app
# AZURE_STORAGE_ACCOUNT=yourstorageaccount
# AZURE_STORAGE_CONTAINER=uploads
# SESSION_SECRET is resolved by an App Service Key Vault reference in Azure.
